# Copie este arquivo para .env se quiser sobrescrever configuracoes padrao.
# cp .env.example .env
#
# A LLM e LOCAL (Hugging Face) — NAO requer chave de API nem custo.
# Voce pode opcionalmente trocar o modelo usado:

# Modelo Hugging Face para geracao de texto (default: google/flan-t5-large)
# Opcoes: flan-t5-small (~300MB, rapido), flan-t5-base (~1GB), flan-t5-large (~3GB, recomendado)
HF_MODEL=google/flan-t5-large
